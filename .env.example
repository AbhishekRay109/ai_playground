# Copy to .env and adjust. Placeholders only: never commit real secrets.
# Every variable is optional unless noted; defaults are shown.

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=120
LLM_HISTORY_MESSAGES=10

# --- Embeddings / vectors ---
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# Set to true to let the backend download embedding weights on first use.
EMBEDDING_ALLOW_DOWNLOAD=false
# Optional local reranker, e.g. cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=
# Leave empty for Qdrant local (embedded) mode; set to use a Qdrant server.
QDRANT_URL=

# --- Documents ---
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=5
MAX_DOCUMENTS=200
MAX_PDF_PAGES=500
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3

# --- Web search (SearXNG) ---
SEARXNG_URL=http://localhost:8080
# Used by scripts/run-searxng.sh and docker-compose. Generate with `openssl rand -hex 32`
SEARXNG_SECRET=change-me-to-a-random-string
SEARCH_RESULTS=5
WEB_FETCH_PAGES=3
WEB_FETCH_TIMEOUT_S=8
WEB_RESPECT_ROBOTS=true
# Comma-separated; empty allowlist = any public domain.
WEB_ALLOWED_DOMAINS=
WEB_BLOCKED_DOMAINS=

# --- SQL assistant ---
SQL_ROW_LIMIT=200
SQL_TIMEOUT_S=3

# --- Agent ---
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=4
AGENT_TOOL_TIMEOUT_S=45
AGENT_REQUEST_TIMEOUT_S=240

# --- HTTP / security ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=262144
LOG_LEVEL=INFO
# Logs never contain prompts or document text unless this is true.
LOG_CONTENT=false
